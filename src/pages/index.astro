async function footFrame(ft, T = null) {   // with T: the site cut's still at T
  const sc = T != null && CLIP_META[`journey_${ending()}_site`], name = sc ? `journey_${ending()}_site` : jv() ? `journey_${ending()}` : null, m = name && CLIP_META[name];
