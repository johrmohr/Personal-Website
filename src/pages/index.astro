VID.addEventListener('loadeddata', boot, { once: true });
(async () => { try { const r = await fetch('bh-journey.mp4'); if (!r.ok) throw new Error(r.status); VID.src = URL.createObjectURL(await r.blob()); } catch { VID.src = 'bh-journey.mp4'; } VID.load(); })();
