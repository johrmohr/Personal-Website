/* a walkthrough as the site would play it: hold each section, scroll, the journey plays between them (seconds) */
const WALK = [{ hold: 2.5, i: 0 }, { move: [0, 1] }, { hold: 3.5, i: 1 }, { move: [1, 2] }, { hold: 4.5, i: 2 }, { move: [2, 1] }, { hold: 2.5, i: 1 }, { move: [1, 0] }, { hold: 2, i: 0 }];
