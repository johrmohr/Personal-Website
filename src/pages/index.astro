const FRAMES = [[K[1] + 2.4, 'NASA · the plunge', 'nasa', null], [K[1] + SWITCH, 'the handoff, before the arch', 'nasa', null], [K[1] + SWITCH + .8, 'it rises out of the line', 'art', null], [K[1] + SWITCH + 2.2, 'the sea comes up', 'art', null], [K[1] + SWITCH + 4.5, 'the camera pulls back', 'art', null], [K[1] + SWITCH + 6.5, 'coming to rest', 'art', null], [K[2], 'sunrise', 'rest', 'sun'], [K[2], 'moonrise', 'rest', 'moon']];
