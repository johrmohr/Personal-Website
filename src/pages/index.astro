/* debug hook: render any moment, for frame checks and exports */
window.__journey = { K, END, LOCK, siteFrame, setEnding, exportRun, WALK_LEN, go: goTo, get state() { const sc = site() || {}, v = AV(); return { T: D.T, J: D.J, i: D.i, busy: D.busy, back: BACK, leave: LEAVE ? LEAVE.a : 0, video: v === sc.r ? 'reversed' : v === sc.f ? 'site' : 'journey' }; }, videos: { JV, SC, SCR }, stills(on) { STILLS = on; if (!on) FOOT_IMG = CLIP_IMG = null; }, CLIP_META, CLIPS, get canvas() { return R.canvas; }, at(J) { S.J = J; setPlaying(false); }, async render(J, live = 4, end, width = 0) { owner = 'strip'; if (end) setEnding(end); forceW = width; S.J = J; setPlaying(false); await seekVideo(footageTime(J)); S.live = live; draw(); forceW = 0; owner = 'player'; } };

/* ---------- boot: the website preview opens first; #review goes straight to the player ---------- */
setPlaying(!reduce);
const boot = async () => {
